# ─────────────────────────────────────────────────────────────────────────
# This is the content for your .env file (which is git-ignored).
#
#   1. Create it:   cp DELETEME .env    (or copy the lines below into .env)
#   2. Fill in the real values.
#   3. Delete this DELETEME file.
#
# build-app.sh auto-sources .env, so these become available to the build.
# ─────────────────────────────────────────────────────────────────────────

# Your Apple ID email (the account in your Apple Developer membership).
# Needed for: --sign (notarization).
APPLE_ID=your@email.com

# App-specific password for the Apple ID above — NOT your normal password.
# Generate one at https://account.apple.com > Sign-In and Security >
# App-Specific Passwords. Format looks like: xxxx-xxxx-xxxx-xxxx
# Needed for: --sign (notarization).
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your 10-character Apple Developer Team ID.
# Find it at https://developer.apple.com/account > Membership details.
# Needed for: --sign and --mas.
APPLE_TEAM_ID=XXXXXXXXXX
